{
  "name": "fsend-site",
  "version": "0.4.0",
  "description": "Peer-to-peer file transfer in the browser",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/build-wasm.mjs && vite",
    "build:wasm": "node scripts/build-wasm.mjs",
    "build": "node scripts/build-wasm.mjs && node scripts/buildinfo.mjs && vite build && vite build --ssr src/entry-server.tsx --outDir .ssg && node scripts/ssg.mjs",
    "serve": "vite preview",
    "test": "node test/run.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:e2e": "playwright test",
    "test:all": "node test/run.mjs && playwright test"
  },
  "license": "CC-BY-NC-4.0",
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "prettier": "^3.10.1",
    "solid-devtools": "^0.34.5",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-solid": "^2.11.16"
  },
  "dependencies": {
    "@solidjs/meta": "^0.29.8",
    "@solidjs/router": "^1.0.3",
    "qrcode-generator": "^2.0.4",
    "solid-icons": "^1.2.0",
    "solid-js": "^1.9.19"
  }
}
