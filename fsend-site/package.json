{
  "name": "fsend-site",
  "private": true,
  "version": "0.0.0",
  "description": "Peer-to-peer file transfer in the browser",
  "type": "module",
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "node scripts/buildinfo.mjs && vite build && vite build --ssr src/entry-server.tsx --outDir .ssg && node scripts/ssg.mjs",
    "serve": "vite preview",
    "test": "node test/run.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:e2e": "playwright test",
    "test:all": "node test/run.mjs && playwright test"
  },
  "license": "CC-BY-NC-4.0",
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.4",
    "esbuild": "^0.28.2",
    "solid-devtools": "^0.34.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vite-plugin-solid": "^2.11.14"
  },
  "dependencies": {
    "@solidjs/meta": "^0.29.4",
    "@solidjs/router": "^1.0.0",
    "hash-wasm": "^4.12.0",
    "jszip": "^3.10.2",
    "qrcode-generator": "^2.0.4",
    "solid-icons": "^1.2.0",
    "solid-js": "^1.9.15"
  }
}
